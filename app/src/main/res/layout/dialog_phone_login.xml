<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">

    <EditText android:id="@+id/etPhone"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="手机号（11 位）" android:inputType="phone"
        android:maxLength="11" android:textSize="15sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <EditText android:id="@+id/etCode"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:hint="短信验证码"
            android:inputType="number" android:maxLength="6" android:textSize="15sp" />
        <Button android:id="@+id/btnSendCode"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="获取验证码" android:textSize="13sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="首次登录会自动创建账号；验证码 60 秒内有效。"
        android:textSize="12sp" android:textColor="#8A94A6"
        android:layout_marginTop="10dp" />
</LinearLayout>
